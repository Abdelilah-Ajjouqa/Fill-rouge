@baseUrl = http://localhost:3000
@token = YOUR_JWT_HERE

### Login (get JWT)
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@fitmanager.com",
  "password": "securepassword123"
}

### Get my profile
GET {{baseUrl}}/auth/me
Authorization: Bearer {{token}}

### Create gym (Super Admin)
# Use multipart/form-data when uploading a logo file.
POST {{baseUrl}}/gyms
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "FitClub Downtown",
  "address": "123 Main St, Casablanca",
  "phone": "0600000000",
  "isActive": true,
  "halls": [
    { "name": "A-1", "type": "Yoga", "capacity": 20 },
    { "name": "B-2", "type": "Strength", "capacity": 25 }
  ]
}

### Create admin (Super Admin)
POST {{baseUrl}}/auth/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "admin@fitmanager.com",
  "password": "securepassword123",
  "role": "ADMIN",
  "firstName": "Admin",
  "lastName": "User",
  "gymId": "GYM_ID_HERE"
}

### Create coach (Admin or Super Admin)
POST {{baseUrl}}/auth/register
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "coach@fitmanager.com",
  "password": "coachpassword123",
  "role": "COACH",
  "firstName": "John",
  "lastName": "Doe",
  "gymId": "GYM_ID_HERE"
}

### Get user by ID
GET {{baseUrl}}/users/YOUR_USER_ID_HERE
Authorization: Bearer {{token}}

### Create member (Admin or Coach)
POST {{baseUrl}}/members
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "email": "member@fitmanager.com",
  "password": "memberpassword123",
  "firstName": "Jane",
  "lastName": "Smith",
  "phone": "0600000000",
  "dateOfBirth": "2000-01-01"
}

### Create activity (Admin)
POST {{baseUrl}}/activities
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "name": "CrossFit Basics",
  "hallId": "HALL_ID",
  "coach": "COACH_USER_ID",
  "monthlyPrice": 300,
  "maxCapacity": 60,
  "schedule": [
    { "day": "Monday", "startTime": "16:00", "endTime": "17:00" }
  ]
}

### Create subscription (Admin or Coach)
POST {{baseUrl}}/subscriptions
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "member": "MEMBER_ID",
  "activity": "ACTIVITY_ID",
  "startDate": "2026-03-01"
}

### Create payment (full only)
POST {{baseUrl}}/payments
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "subscription": "SUBSCRIPTION_ID",
  "amount": 300,
  "paidAt": "2026-03-01"
}

### List unpaid subscriptions
GET {{baseUrl}}/payments/unpaid
Authorization: Bearer {{token}}
